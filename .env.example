# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/forja_rocktalica?schema=public"

# Secreto para firmar los JWT (usa una cadena larga y aleatoria; nunca la subas al repo)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

PORT=4000

# URL(s) del frontend permitidas por CORS, separadas por coma (nunca "*")
CORS_ORIGIN="http://localhost:3000"
